# Optional. Copy this file to ".env" only if you need to change something.

# Backend address used by the Vite dev proxy (default: https://localhost:7085).
# If you run the backend with the "http" profile, use: http://localhost:5085
# VITE_PROXY_TARGET=https://localhost:7085

# Only for production builds where the frontend and backend have different addresses.
# VITE_API_URL=https://api.yourdomain.com/api
